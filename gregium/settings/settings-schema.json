{
    "$schema": "https://json-schema.org/draft-04/schema#",
    "type":"object",
    "required":["stt","tts","ai","terminal"],
    "properties": {
        "stt": {
            "type":"object",
            "description": "All relating settings to Speech-To-Text",
            "properties": {
                "lang":{
                    "type":"string",
                    "add_type":"language",
                    "default": "en",
                    "description": "Device language (should be like 'en')"
                }
            }
        },
        "tts": {
            "type":"object",
            "description": "All relating settings to Text-To-Speech",
            "properties": {
                "tts_voice": {
                    "default":"en-US-EmmaMultilingualNeural",
                    "type":"string",
                    "add_type":"tts_voice",
                    "description": "The default voice for TTS (tts_voices.txt for list)"
                }
            }
        },
        "ai": {
            "type":"object",
            "description": "All relating settings to AI",
            "properties": {
                "default_model": {
                    "default":"",
                    "type":"string",
                    "add_type":"llama_model",
                    "description": "The default Ollama model to use (use Ollama list to see installed)"
                },
                "loud_tools": {
                    "default":false,
                    "type":"boolean",
                    "description": "If the tool calls and errors run by AI should be announced in stdout"
                }
            }
        },
        "terminal": {
            "type":"object",
            "description": "All relating settings to Terminal",
            "properties": {
                "help_enabled": {
                    "default": true,
                    "type":"boolean",
                    "description": "If help text should be shown by default on terminal choice"
                },
                "carousel_length": {
                    "default": 10,
                    "type": "integer",
                    "description": "The minimum length in choice that will start to use a carousel"
                }
            }
        }
    }
}